<?xml version="1.0"?>
<ruleset name="CartShare">
	<description>WordPress Coding Standards for the CartShare plugin.</description>

	<rule ref="WordPress"/>

	<!-- Only scan PHP files in the plugin's own code. -->
	<arg value="p"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<!-- Only errors are blocking; informational warnings (direct DB calls,
		caching) are reported but do not fail the gate. -->
	<arg name="warning-severity" value="0"/>

	<!--
		Test files are exempted from the strict WordPress standard. They define
		stub classes (multiple per file, `function` keyword in signatures,
		non-WPCS filenames) that the WordPress ruleset forbids by design. The
		production plugin code under includes/ and templates/ is fully checked.
	-->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>wp-admin/*</exclude-pattern>
	<exclude-pattern>wp-includes/*</exclude-pattern>
	<exclude-pattern>wp-content/*</exclude-pattern>
	<exclude-pattern>.devstation/*</exclude-pattern>
	<exclude-pattern>.agents/*</exclude-pattern>
	<exclude-pattern>.claude/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>
</ruleset>
